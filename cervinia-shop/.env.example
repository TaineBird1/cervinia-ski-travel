# Copy this file to .env and fill in your own values.
# NEVER commit your real .env file or share your secret key with anyone.

PORT=3000

# Full URL where this site will run (no trailing slash).
# Locally this is fine as-is. In production, set it to your real domain.
DOMAIN=http://localhost:3000

# Stripe keys — from https://dashboard.stripe.com/apikeys
# Use your TEST keys (sk_test_... / pk_test_...) until you're ready to go live.
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Stripe webhook signing secret — from `stripe listen` (local) or your
# Stripe Dashboard > Developers > Webhooks (production).
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Business details used on the generated invoice
BUSINESS_NAME=Cervinia Travel Services
BUSINESS_EMAIL=info@cerviniatravelservices.com
BUSINESS_WHATSAPP=+39 366 879 4487
BUSINESS_ADDRESS=Breuil-Cervinia, Aosta Valley, Italy
