# Copy this file to .env and fill in your own values.
# NEVER commit your real .env file or share your secret key with anyone.

PORT=3000

# Business details used on the PDF quote and emails
BUSINESS_NAME=Cervinia Travel Services
BUSINESS_EMAIL=info@cerviniatravelservices.com
BUSINESS_WHATSAPP=+39 366 879 4487
BUSINESS_ADDRESS=Breuil-Cervinia, Aosta Valley, Italy

# Resend API key — from https://resend.com/api-keys
# Used to email the quote PDF to customers and notify the business. Optional:
# if left unset, enquiries still work and the quote stays downloadable.
RESEND_API_KEY=

# Sender shown on invoice emails. Defaults to onboarding@resend.dev, but
# that shared address only delivers to the email that owns your Resend
# account — it will NOT reach real customers. Verify your own domain in
# Resend (Dashboard -> Domains) and switch this to something like
# "Cervinia Travel Services <bookings@cerviniatravelservices.com>"
RESEND_FROM_EMAIL=Cervinia Travel Services <onboarding@resend.dev>

# Admin dashboard (/admin) — revenue & booking stats, password-protected.
# Pick a strong password; this is the only thing standing between the
# public internet and your real revenue numbers.
ADMIN_PASSWORD=

# Used to sign the admin login session cookie. Any long random string.
# If left unset, one is derived from ADMIN_PASSWORD (so the admin area is
# never signed with a value that is public in the source code).
ADMIN_SESSION_SECRET=

# Where enquiries and quote PDFs are saved. Leave unset to use the app folder
# (wiped on every restart on Render's free plan). With a Render persistent
# disk attached, set this to its mount path, e.g. /var/data
DATA_DIR=

# Direct bank-transfer details shown on quotes, emails and the confirmation
# page. Defaults are set in lib/bankDetails.js; override here only if they change.
# BANK_ACCOUNT_NAME=
# BANK_NAME=
# BANK_ADDRESS=
# BANK_ACCOUNT_NUMBER=
# BANK_IBAN=
# BANK_BIC=
